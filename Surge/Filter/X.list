# Website, API and legacy links
DOMAIN-SUFFIX,x.com
DOMAIN-SUFFIX,twitter.com
DOMAIN-SUFFIX,twttr.com

# Images, video and static assets
DOMAIN-SUFFIX,twimg.com

# Short links
DOMAIN-SUFFIX,t.co

# Live video
DOMAIN-SUFFIX,periscope.tv
DOMAIN-SUFFIX,pscp.tv

# Grok website, xAI API, generated media and shared sign-in
DOMAIN-SUFFIX,grok.com
DOMAIN-SUFFIX,x.ai
DOMAIN-SUFFIX,grokusercontent.com
DOMAIN-SUFFIX,grokipedia.com
DOMAIN-SUFFIX,spacex.ai

# Grok Bot website and mail subdomains
DOMAIN-SUFFIX,grokbot.com

# Grok Bot uses Cursor infrastructure for API, assets and hosted computers.
# DOMAIN-SUFFIX also covers nested hosts such as <computer>.<cluster>.cursorvm.com.
# These domains intentionally overlap Cursor.list so either list works on its own.
DOMAIN-SUFFIX,cursor.com
DOMAIN-SUFFIX,cursor.sh
DOMAIN-SUFFIX,cursorapi.com
DOMAIN-SUFFIX,cursor-cdn.com
DOMAIN-SUFFIX,cursorvm.com

# Client downloads (match only this S3 bucket)
DOMAIN,anysphere-binaries.s3.us-east-1.amazonaws.com
